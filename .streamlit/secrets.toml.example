# Copie este arquivo para .streamlit/secrets.toml e defina seus valores.
# NUNCA suba o secrets.toml real para o GitHub (já está no .gitignore).

# Senha de acesso ao dashboard (troque para algo seu).
app_password = "1234"

# Chave da AwesomeAPI (https://awesomeapi.com.br/account#keys) — tempo real sem cache.
# Deixe vazio/remova se não tiver chave; o app ainda funciona com cache de 1 minuto.
awesomeapi_key = ""

# Telegram — alertas de mudança de sinal (ver topo de alerts.py).
# Como criar o bot: fale com @BotFather no Telegram -> /newbot -> guarde o token.
# Descubra o chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates
telegram_token = ""
telegram_chat = ""

# IA — DESLIGADO por padrão (decidido para não gerar custo de tokens).
# O parecer narrativo do LLM não é chamado em nenhum caminho do código.
# As estatísticas (Monte Carlo, VaR, P(TP/SL)) rodam 100% offline. Manter vazio.
llm_api_key = ""
llm_base_url = ""
llm_model = ""
