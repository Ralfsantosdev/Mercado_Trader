# Copie este arquivo para .streamlit/secrets.toml e defina sua própria senha.
# NUNCA suba o secrets.toml real para o GitHub (adicione ao .gitignore).

app_password = "1234"

# Chave da AwesomeAPI (https://awesomeapi.com.br/account#keys) — tempo real sem cache.
# Deixe vazio/remova se não tiver chave; o app ainda funciona com cache de 1 minuto.
awesomeapi_key = ""

# Alertas no Telegram (opcional) — veja como criar o bot em alerts.py:
#   token: crie com @BotFather no Telegram (/newbot) e copie o token.
#   chat:  fale com seu bot (Start) e veja o id em getUpdates.
# telegram_token = "123456789:AAH..."
# telegram_chat  = "987654321"
